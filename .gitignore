# Environment — never commit real secrets
.env
.venv/
__pycache__/
*.pyc
*.pyo

# Data — too large for git
data/raw/
data/processed/
data/vector_store/
data/embeddings_cache/*.json  # ← Cache files, not the directory itself
# Embedding cache — exclude cache files
data/embeddings_cache/*.json

# But keep directory structure visible
!data/embeddings_cache/.gitkeep
!data/vector_store/.gitkeep
# MLflow
mlflow_artifacts/

# IDE
.vscode/settings.json
.idea/

# Build
dist/
*.egg-info/

# OS
.DS_Store
**/.DS_Store

# Python
*.pyo
*.pyd
.Python

