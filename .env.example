# RAG Chunking Configuration
CHUNK_MAX_LENGTH=1000
CHUNK_MIN_LENGTH=50
CHUNK_OVERLAP=100

# Embedding Configuration
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CACHE_DIR=./data/embeddings_cache

# Retrieval Configuration
RETRIEVAL_TOP_K=10
RETRIEVAL_BATCH_SIZE=100
RETRIEVAL_METADATA_LIMIT=100
RETRIEVAL_STATS_SAMPLE_SIZE=100

# Hybrid Retrieval Weights (must sum to 1.0)
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3

# Reranker Configuration
RERANKER_RELEVANCE_THRESHOLD=0.5

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# GitHub API (get free token at github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# NVD API Configuration (free key at nvd.nist.gov/developers/request-an-api-key)
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=your_nvd_api_key_here

# OSV API Configuration
OSV_API_BASE_URL=https://api.osv.dev/v1

# Vector Store
CHROMA_PERSIST_DIR=./data/vector_store
CHROMA_COLLECTION_NAME=vulnremedy_knowledge

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
